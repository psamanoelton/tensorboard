+def _repository_label(repo, target):
+    # Label.workspace_name returns a canonical repository name for labels that
+    # point at a repository generated by a Bzlmod extension.
+    prefix = "@@" if repo.startswith("+") else "@"
+    return Label("%s%s//:%s" % (prefix, repo, target))
+
